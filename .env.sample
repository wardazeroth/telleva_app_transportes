# Example env file, make a copy and name it `.env`
# ------------------------------------------------------------------------------

# Environment of the App, options: development, production
DJANGO_ENVIRONMENT=production

# The secret key of the Django App, keep it secure
# To generate a new key, type `django-admin shell` in a terminal
# after type `from django.core.management.utils import get_random_secret_key`
# then send `get_random_secret_key()` an a new secret key is displayed
SECRET_KEY=''

# Set to True in development environment, on production set to False.
DEBUG=False

# List of allowed host, if multiple separate it by comma `,`
ALLOWED_HOSTS=127.0.0.1,localhost

# Database variables
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
DB_HOST=localhost
DB_PORT=5432


# Set the SMTP settings 
EMAIL_HOST=''
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=''
EMAIL_HOST_PASSWORD=''
DEFAULT_FROM_EMAIL=''

# Security variables
# Only works if the DJANGO_ENVIRONMENT is `production`

# Set the domain or subdomain of the website. ex. test.com
SECURE_SSL_HOST=''

# Enable the SSL redirect, enabled by default, options: True, False
SECURE_SSL_REDIRECT=True

# Set the seconds of the duration of the HSTS session, defaults to 3600 seconds
SECURE_HSTS_SECONDS=3600

# Set the session cookie security, options: True, False, default enabled
SESSION_COOKIE_SECURE=True

# Set the session cookie age, defaults to 3600 seconds
SESSION_COOKIE_AGE=3600

# Set the session cookie expire at browser close, enabled by default, options: True, False
SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# Set the CSRF forms cookie secure, enabled by default, options: True, False
CSRF_COOKIE_SECURE=True